rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null && request.auth.uid is string;
    }

    match /resources/uploads/{uid}/{fileName} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /resources/output/{jobId}/{fileName} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
