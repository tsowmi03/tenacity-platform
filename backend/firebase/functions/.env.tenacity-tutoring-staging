# Non-secret function parameters for the staging project.
#
# Firebase loads this file automatically when deploying with
# --project tenacity-tutoring-staging (the .env.<projectId> convention).
# Secrets do NOT belong here; they live in staging Secret Manager.
#
# RESOURCE_PDF_PREVIEW_URL is deliberately empty. The production value points
# at a Cloud Run service in the production project
# (resource-pdf-converter-398065992407), so copying it here would make staging
# functions call production infrastructure. src/resources/index.js declares
# this param with a default of "", so empty degrades preview rather than
# crashing.
RESOURCE_PDF_PREVIEW_URL=

# Resource generation is excluded from the staging deploy set entirely (see
# backend/firebase/inventory/staging-functions.json), so this is never read —
# but it is declared in the same shared index.js, and Firebase's non-interactive
# deploy requires a dotenv value for every declared param regardless of which
# functions actually deploy.
RESOURCE_LLM_MODEL=
RESOURCE_LLM_FAILOVER_ENABLED=true

# Disabled in staging to avoid Anthropic spend against the staging budget.
RESOURCE_PD_TEXT_SOURCING=false

# Staging has no Xero tenant.
XERO_PAYMENT_SYNC=false

# Every outbound email from a non-production project is redirected here by
# src/email/sendGuard.js, with the intended recipients preserved in an
# X-Original-To header. If this is left empty the guard DROPS outbound mail
# instead of sending it — staging fails closed, never open.
#
# Set this to an address you actually read before testing any email flow.
STAGING_EMAIL_SINK=tsowmi03@gmail.com

# PostHog business events (TP-35). Staging shares the production project (the
# free plan allows one, TP-36): every event carries environment=staging, and
# dashboards filter it out. Resource generation isn't deployed to staging
# (inventory/staging-functions.json), so no LLM analytics come from here.
POSTHOG_PROJECT_TOKEN=phc_veJUQQxnqJBE9B4umMUfLqLfB36CfJDUCnncMDGnxLwY
POSTHOG_HOST=https://us.i.posthog.com
