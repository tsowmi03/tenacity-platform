{
  "name": "tenacity-web-portal-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "backfill:archived": "node scripts/backfillArchived.js",
    "backfill:roll-marks": "node scripts/backfillRollMarks.js",
    "dryrun:roll-marks": "node scripts/backfillRollMarks.js --dry-run",
    "backfill:attendance-week-num": "node scripts/backfillAttendanceWeekNum.js",
    "dryrun:attendance-week-num": "node scripts/backfillAttendanceWeekNum.js --dry-run",
    "backfill:resource-topics": "node scripts/backfillResourceTopics.js",
    "dryrun:purge-old-invoices": "node scripts/dryRunPurgeOldInvoices.js",
    "purge-old-invoices:once": "node scripts/dryRunPurgeOldInvoices.js --commit --yes",
    "dryrun:purge-orphaned-chats": "node scripts/purgeOrphanedChats.js",
    "purge-orphaned-chats:once": "node scripts/purgeOrphanedChats.js --commit --yes",
    "seed:staging": "node scripts/seedStaging.js",
    "smoke": "node -e \"const f = require('./lib/index.js'); console.log(Object.keys(f).sort().join('\\n'))\"",
    "test": "node --test --test-reporter=spec 'test/unit/**/*.test.js'",
    "test:diagrams:render": "node scripts/renderDiagramFixtures.js",
    "test:diagrams:spike-renderers": "node scripts/spikeDiagramRenderers.js",
    "test:resources:render": "node scripts/renderResourceFixtures.js",
    "test:emulator": "firebase --config ../../../firebase.json emulators:exec --only auth,firestore --project demo-tenacity-functions-test \"node --test --test-concurrency=1 --test-reporter=spec 'test/integration/**/*.test.js'\"",
    "test:all": "npm run test && npm run test:emulator"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@sendgrid/mail": "^8.1.4",
    "docx": "^9.6.1",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.2",
    "google-auth-library": "^10.9.1",
    "luxon": "^3.6.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.18.0",
    "sharp": "^0.33.5",
    "stripe": "^17.7.0",
    "xero-node": "^10.0.0",
    "xlsx": "^0.18.5"
  }
}
