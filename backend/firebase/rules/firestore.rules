rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.uid is string;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function currentUserExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserHasRole(roleName) {
      return currentUserExists()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == roleName;
    }

    function hasRole(roleName) {
      return signedIn()
        && (request.auth.token.role == roleName || currentUserHasRole(roleName));
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isTutor() {
      return hasRole('tutor');
    }

    function isStaff() {
      return isAdmin() || isTutor();
    }

    function onlyChangedKeys(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function currentUserStudentListContains(studentId) {
      return currentUserExists()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.students is list
        && studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.students;
    }

    function parentCanAccessStudent(studentId, data) {
      return signedIn()
        && (
          (data.parents is list && request.auth.uid in data.parents)
          || data.primaryParentId == request.auth.uid
          || currentUserStudentListContains(studentId)
        );
    }

    function chatParticipant(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function feedbackReadable(data) {
      return isStaff()
        || (
          signedIn()
          && (
            (data.parentIds is list && request.auth.uid in data.parentIds)
            || parentCanAccessStudent(data.studentId, get(/databases/$(database)/documents/students/$(data.studentId)).data)
          )
        );
    }

    // Part of the tutor-session contract: feedback written from a marked roll
    // carries the class and session it came from, plus a progress status.
    // All three are optional, because an admin may still record feedback
    // outside a session and because records written before the contract have
    // none of them.
    function validFeedbackProgress() {
      return !('progress' in request.resource.data)
        || request.resource.data.progress in ['ahead', 'onTrack', 'needsSupport'];
    }

    function validFeedbackSessionLink() {
      // classId and sessionId travel together — a session id that names no
      // class cannot be matched back to a roll.
      return (!('classId' in request.resource.data) && !('sessionId' in request.resource.data))
        || (
          request.resource.data.classId is string
          && request.resource.data.classId.size() > 0
          && request.resource.data.sessionId is string
          && request.resource.data.sessionId.size() > 0
        );
    }

    function validFeedbackCreate() {
      return isStaff()
        && request.resource.data.keys().hasOnly([
          'studentId',
          'tutorId',
          'parentIds',
          'subject',
          'feedback',
          'createdAt',
          'isUnread',
          'classId',
          'sessionId',
          'progress'
        ])
        && request.resource.data.keys().hasAll([
          'studentId',
          'tutorId',
          'parentIds',
          'subject',
          'feedback',
          'createdAt',
          'isUnread'
        ])
        && request.resource.data.studentId is string
        && request.resource.data.studentId.size() > 0
        && request.resource.data.tutorId == request.auth.uid
        && request.resource.data.parentIds is list
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.feedback is string
        && request.resource.data.feedback.size() > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.isUnread == true
        && validFeedbackProgress()
        && validFeedbackSessionLink();
    }

    match /classes/{classId} {
      // Public website currently reads class slots directly.
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /attendance/{attendanceId} {
        // Compatibility-first: the mobile app uses collectionGroup attendance
        // queries and staff-side attendance editing.
        allow read: if signedIn();
        allow create, update, delete: if isStaff();
      }
    }

    // Collection-group reads of attendance.
    //
    // The path-scoped rule above secures documents reached through their own
    // class, but a collectionGroup query is not matched by a path-scoped rule
    // and fell through to the deny-all at the bottom of this file. The mobile
    // app loads a whole week's sessions in one query, and
    // `fetchUpcomingClassForParent` has always used one — that call was
    // failing with permission-denied and reporting "No upcoming class".
    //
    // Read only, and no wider than what is already granted: the rule above
    // lets any signed-in user read every attendance document. Writes stay
    // staff-only on the path-scoped rule.
    match /{path=**}/attendance/{attendanceId} {
      allow read: if signedIn();
    }

    match /terms/{termId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isAdmin() || (signedIn() && resource.data.archived == false);
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin()
        || isTutor()
        || isOwner(userId)
        || (signedIn() && resource.data.role in ['admin', 'tutor']);

      allow create: if isAdmin();
      allow update: if isAdmin()
        || (
          isOwner(userId)
          && onlyChangedKeys([
            'firstName',
            'lastName',
            'phone',
            'email',
            'fcm_token',
            'termsAccepted',
            'acceptedTermsVersion',
            'acceptedTermsAt',
            'readAnnouncements',
            'updatedAt'
          ])
        );
      allow delete: if isAdmin() || isOwner(userId);
    }

    match /students/{studentId} {
      allow read: if isStaff() || parentCanAccessStudent(studentId, resource.data);
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (
          parentCanAccessStudent(studentId, resource.data)
          && onlyChangedKeys(['firstName', 'lastName', 'updatedAt'])
        );
      allow delete: if isAdmin() || parentCanAccessStudent(studentId, resource.data);
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 10;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participants
        && onlyChangedKeys(['deletedFor', 'typingStatus', 'unreadCounts', 'updatedAt']);
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if chatParticipant(chatId);
        allow create, delete: if false;
        allow update: if chatParticipant(chatId) && onlyChangedKeys(['readBy']);
      }
    }

    match /invoices/{invoiceId} {
      allow read: if isAdmin() || (signedIn() && resource.data.parentId == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.parentId == request.auth.uid
          && request.resource.data.parentId == request.auth.uid
          && onlyChangedKeys(['xeroInvoicePdfPath', 'updatedAt'])
        );
    }

    match /invoiceDrafts/{draftId} {
      allow read, write: if isAdmin();
    }

    // Weekly parent email drafts. Admins compose these in the portal; the send
    // status and delivery counts are written by `sendParentEmailBlast` through
    // the admin SDK, which bypasses rules.
    //
    // Editing stops once the send claims the draft. A composer in another tab
    // holds a stale `draft` status and would happily delete a blast that is
    // mid-flight, leaving parents emailed from the Function's in-memory
    // snapshot with no record of what went out or to how many.
    match /parentEmailBlasts/{blastId} {
      allow read, create: if isAdmin();
      allow update, delete: if isAdmin()
        && !(resource.data.get('status', 'draft') in ['sending', 'sent'])
        && !('deliveryStartedAt' in resource.data);
    }

    match /payslips/{payslipId} {
      allow read: if isAdmin() || (signedIn() && resource.data.tutorId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow read: if feedbackReadable(resource.data);
      allow create: if validFeedbackCreate();
      allow update, delete: if isStaff();
      allow update: if feedbackReadable(resource.data)
        && request.resource.data.isUnread == false
        && onlyChangedKeys(['isUnread']);
    }

    match /waitlistEntries/{entryId} {
      allow read: if isStaff() || (signedIn() && resource.data.parentId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /resourceJobs/{jobId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /userSettings/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create, update, delete: if isOwner(userId);
    }

    match /userTokens/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create, update: if isOwner(userId) && request.resource.data.uid == userId;
      allow delete: if isAdmin() || isOwner(userId);

      match /tokens/{tokenId} {
        allow read: if isAdmin() || isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if isAdmin() || isOwner(userId);
      }
    }

    match /enrolments/{enrolmentId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Year 11 class interest registrations. The public website writes these
    // through the admin SDK, which bypasses rules, so no client may create or
    // delete them. Admins read them and may only update the triage fields.
    match /year11Interest/{interestId} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && onlyChangedKeys(['status', 'archived', 'statusUpdatedAt']);
      allow create, delete: if false;
    }

    // Parent feedback survey responses. The public form writes these through the
    // admin SDK, and admins may only archive a row - never edit what a parent
    // wrote, and never delete a response.
    match /parentSurveyResponses/{responseId} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && onlyChangedKeys(['archived', 'statusUpdatedAt']);
      allow create, delete: if false;
    }

    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /counters/{document=**} {
      allow read, write: if false;
    }

    match /paymentLogs/{document=**} {
      allow read, write: if false;
    }

    match /xeroTokens/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
